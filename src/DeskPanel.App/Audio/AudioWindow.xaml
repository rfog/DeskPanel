<Window x:Class="DeskPanel.App.Audio.AudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:audio="clr-namespace:DeskPanel.App.Audio"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=audio:AudioViewModel}"
        x:ClassModifier="internal"
        Title="Audio" Width="900" Height="700" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen"
        Style="{StaticResource ToolWindowStyle}">
  <Window.Resources>
    <audio:NonEmptyToVisibilityConverter x:Key="TextToVisibility" />
  </Window.Resources>
  <DockPanel Margin="12">

    <!-- Bottom bar: progress and actions -->
    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="{Binding StepText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3" />
        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource FlatButton}" Command="{Binding CancelCommand}" Content="Cancelar" Margin="0,0,6,0" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ProcessCommand}" Content="Procesar seleccionados" />
      </StackPanel>
    </Grid>

    <!-- Top: warning + toolbar -->
    <StackPanel DockPanel.Dock="Top">
      <Border Background="#FFF4D6" BorderBrush="#E8C873" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
              Visibility="{Binding ToolsWarning, Converter={StaticResource TextToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding OpenSettingsCommand}" Content="Configurar…" Margin="10,0,0,0" />
          <TextBlock Text="{Binding ToolsWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <DockPanel Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" Content="Actualizar" Margin="0,0,6,0" />
          <Button Style="{StaticResource FlatButton}" Command="{Binding OpenInputFolderCommand}" Content="Abrir carpeta" Margin="0,0,6,0" />
          <Button Style="{StaticResource FlatButton}" Command="{Binding OpenSettingsCommand}" Content="Configurar…" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" MinHeight="100" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="3*" MinHeight="100" />
      </Grid.RowDefinitions>

      <ListView Grid.Row="0" ItemsSource="{Binding Files}" BorderBrush="{StaticResource LineBrush}">
        <ListView.View>
          <GridView>
            <GridViewColumn Width="34">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Audio" Width="460" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="Tamaño" Width="90" DisplayMemberBinding="{Binding SizeText}" />
            <GridViewColumn Header="Modificado" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
          </GridView>
        </ListView.View>
      </ListView>

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

      <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="6" Background="#101820" Foreground="#D6E2EA"
               BorderBrush="{StaticResource LineBrush}" />
    </Grid>
  </DockPanel>
</Window>
