<Window x:Class="DeskPanel.App.Feeds.FeedsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:feeds="clr-namespace:DeskPanel.App.Feeds"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=feeds:FeedsViewModel}"
        x:ClassModifier="internal"
        Title="Feeds a PDF" Width="1360" Height="780" WindowStartupLocation="CenterScreen"
        Style="{StaticResource ToolWindowStyle}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="12,8">
      <WrapPanel VerticalAlignment="Center">
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,6,0" />
            <TextBlock Text="Actualizar" />
          </StackPanel>
        </Button>
        <TextBlock Text="Fuente" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="150" Margin="0,0,12,0" />
        <TextBlock Text="Perfil PDF" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="120" Margin="0,0,12,0" />
        <CheckBox Content="Mostrar leídos" IsChecked="{Binding ShowRead}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <CheckBox Content="Vista previa al generar" IsChecked="{Binding OpenPreviewAfterGenerate}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource FlatButton}" Command="{Binding OpenOutputFolderCommand}" ToolTip="Abrir la carpeta de PDF">
          <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;" FontSize="14" />
        </Button>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="520" MinWidth="400" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

    <DockPanel Grid.Column="2" Background="{StaticResource RaisedBrush}">
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,6">
        <CheckBox Content="Ver la web original en lugar del artículo con su CSS" IsChecked="{Binding ShowOriginalWeb}" />
      </Border>
      <Grid>
        <TextBlock x:Name="PreviewPlaceholder" Text="Selecciona una entrada para previsualizarla."
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Collapsed" />
      </Grid>
    </DockPanel>

    <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0"
             Background="Transparent" HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type feeds:FeedItemViewModel}">
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,8">
            <DockPanel>
              <!-- Docked below the title: with five buttons beside it the titles were squeezed into a narrow column. -->
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                        ToolTip="Descargar el artículo completo de la web original (sin anuncios ni menús). Pulsa de nuevo para volver al contenido del feed"
                        Command="{Binding DataContext.FetchFullCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="&#xE896;" FontSize="14">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasFullContent}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                        ToolTip="Traducir al español con la IA (conserva las imágenes). El PDF saldrá traducido; el resumen sigue usando el original. Pulsa de nuevo para volver al original"
                        Command="{Binding DataContext.TranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="&#xE775;" FontSize="14">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasTranslation}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                        ToolTip="Resumir con la IA (Configurar › IA). Usa el artículo completo si lo has descargado"
                        Command="{Binding DataContext.SummarizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8E4;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Resumir" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" ToolTip="Generar PDF con el perfil seleccionado"
                        Command="{Binding DataContext.GeneratePdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xEA90;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="PDF" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0" ToolTip="Marcar como leído / no leído"
                        Command="{Binding DataContext.ToggleReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource FlatButton}" ToolTip="Abrir el artículo original"
                        Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE774;" FontSize="14" />
                </Button>
              </StackPanel>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding Entry.Title}" FontSize="14" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                          <Setter Property="FontWeight" Value="Normal" />
                          <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
  </DockPanel>
</Window>
