<Window x:Class="DeskPanel.App.Pdf.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pdf="clr-namespace:DeskPanel.App.Pdf"
        x:ClassModifier="internal"
        Style="{StaticResource ToolWindowStyle}"
        Width="1000" Height="860" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="FileLabel" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="600" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnSummarizeClick"
                  ToolTip="Resumir el PDF con la IA (usa el texto del fichero guardado en disco)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8E4;" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Text="Resumir" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnRevealClick" ToolTip="Mostrar en el Explorador">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Text="Mostrar en carpeta" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource FlatButton}" Click="OnOpenExternalClick" ToolTip="Abrir con la aplicación predeterminada">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;" FontSize="14" Margin="0,0,6,0" />
              <TextBlock Text="Abrir fuera" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <pdf:PdfViewerControl x:Name="Viewer" />
  </DockPanel>
</Window>
