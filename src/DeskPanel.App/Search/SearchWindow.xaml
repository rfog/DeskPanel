<Window x:Class="DeskPanel.App.Search.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:search="clr-namespace:DeskPanel.App.Search"
        xmlns:results="clr-namespace:DeskPanel.Search.Searching;assembly=DeskPanel.Search"
        xmlns:pdf="clr-namespace:DeskPanel.App.Pdf"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=search:SearchViewModel}"
        x:ClassModifier="internal"
        Title="Buscar" Width="1280" Height="820" WindowStartupLocation="CenterScreen"
        Style="{StaticResource ToolWindowStyle}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="460" MinWidth="320" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="12">
      <DockPanel DockPanel.Dock="Top">
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"
                IsDefault="True" Margin="6,0,0,0">
          <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE721;" FontSize="14" />
        </Button>
        <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" FontSize="14"
                 ToolTip="Sintaxis Lucene: &quot;frase exacta&quot;, prefijo*, -excluir, OR, name:fichero" />
      </DockPanel>

      <Expander DockPanel.Dock="Top" Header="Índices" IsExpanded="False" Margin="0,8,0,0">
        <ItemsControl ItemsSource="{Binding Indexes}" Margin="4,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type search:SelectableIndex}">
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <TextBlock>
                  <Run Text="{Binding Definition.Name, Mode=OneWay}" />
                  <Run Text="{Binding Info, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <Expander DockPanel.Dock="Top" Header="Histórico" IsExpanded="False" Margin="0,4,0,0">
        <DockPanel Margin="4,4,0,0">
          <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Command="{Binding ClearHistoryCommand}"
                  Content="Borrar histórico" HorizontalAlignment="Left" Margin="0,6,0,0" />
          <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" MaxHeight="180"
                   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   BorderBrush="{StaticResource LineBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type results:SearchHistoryEntry}">
                <DockPanel Margin="0,1">
                  <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource FlatButton}" Padding="6,0" Margin="6,0,0,0"
                          ToolTip="Quitar del histórico"
                          Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding LastUsedLocal, StringFormat={}{0:dd/MM/yy HH:mm}}"
                             Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding Query}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Expander>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <ProgressBar DockPanel.Dock="Right" Width="80" Height="6" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedHit}" Margin="0,8,0,0"
               HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               BorderBrush="{StaticResource LineBrush}" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type results:SearchHit}">
            <StackPanel Margin="2,6">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Abrir con la aplicación predeterminada"
                            Command="{Binding PlacementTarget.Tag.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="Mostrar en el Explorador"
                            Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="Abrir PDF en ventana con anotación"
                            Command="{Binding PlacementTarget.Tag.OpenInPreviewWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <StackPanel.Tag>
                <!-- ContextMenu lives outside the visual tree; Tag carries the view model across that boundary. -->
                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
              </StackPanel.Tag>
              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding IndexName, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RelativePath, Mode=OneWay}" />
              </TextBlock>
              <TextBlock search:SnippetText.Value="{Binding Snippet}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                         MaxHeight="64" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

    <DockPanel Grid.Column="2" Background="{StaticResource RaisedBrush}">
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,5">
        <DockPanel LastChildFill="False">
          <Button x:Name="PrevMatchButton" Style="{StaticResource FlatButton}" Click="OnPrevMatch" IsEnabled="False"
                  ToolTip="Coincidencia anterior (Mayús+F3)" Margin="0,0,4,0" Padding="9,5">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70E;" FontSize="12" />
          </Button>
          <Button x:Name="NextMatchButton" Style="{StaticResource FlatButton}" Click="OnNextMatch" IsEnabled="False"
                  ToolTip="Coincidencia siguiente (F3)" Padding="9,5">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70D;" FontSize="12" />
          </Button>
          <TextBlock x:Name="MatchInfo" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" />

          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding OpenExternalCommand}"
                  CommandParameter="{Binding SelectedHit}" ToolTip="Abrir con el programa predeterminado">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;" FontSize="13" Margin="0,0,6,0" />
              <TextBlock Text="Abrir" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenWordButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnOpenInWord"
                  Visibility="Collapsed" Margin="0,0,6,0" Content="Word (solo lectura)"
                  ToolTip="Abrir en Word sin posibilidad de modificar el original" />
        </DockPanel>
      </Border>
      <Grid>
        <TextBlock x:Name="PreviewPlaceholder" Text="Selecciona un resultado para previsualizarlo."
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <avalon:TextEditor x:Name="TextPreview" Visibility="Collapsed" IsReadOnly="True" WordWrap="True"
                           ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="8" />
        <pdf:PdfViewerControl x:Name="PdfPreview" Visibility="Collapsed" />
      </Grid>
    </DockPanel>
  </Grid>
</Window>
