<Window x:Class="DeskPanel.App.Indexes.UpdateAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:indexes="clr-namespace:DeskPanel.App.Indexes"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=indexes:UpdateAllViewModel}"
        x:ClassModifier="internal"
        Title="Actualizar todos los índices" Width="520" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ToolWindowStyle}">
  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Button Style="{StaticResource PrimaryButton}" Command="{Binding CancelOrCloseCommand}" Content="{Binding ButtonText}"
              HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" />
    </StackPanel>

    <!-- Which index is being worked on, and how many are left -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding IndexName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <DockPanel Margin="0,2,0,10">
        <TextBlock Text="{Binding CounterText}" FontWeight="SemiBold" Margin="0,0,8,0" />
        <TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource MutedBrush}" />
      </DockPanel>

      <ProgressBar Height="10" Minimum="0" Maximum="{Binding OverallMaximum}" Value="{Binding OverallValue}" />
      <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8" />

      <ProgressBar Height="6" Minimum="0" Maximum="{Binding CurrentMaximum}" Value="{Binding CurrentValue}" />
      <TextBlock Text="{Binding PhaseText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                 Margin="0,3,0,10" MinHeight="16" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource RaisedBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
